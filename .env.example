# ============================================================
# 秒杀商城 Docker Compose 环境变量配置模板
# 使用方法：cp .env.example .env，然后修改各项值
# 安全提示：所有 change_me_* 占位符必须替换为强随机值
# ============================================================

# ---------- MySQL ----------
# root 超级管理员口令（生产建议 >= 16 位强随机）
MYSQL_ROOT_PASSWORD=change_me_root_password
# 业务数据库名（首次启动自动创建）
MYSQL_DATABASE=seckill_mall
# 业务账号（仅拥有 MYSQL_DATABASE 库权限）
MYSQL_USER=seckill
# 业务账号口令
MYSQL_PASSWORD=change_me_mysql_password
# 宿主机映射端口（仅绑回环 127.0.0.1，调试用）
DB_PORT=3306

# ---------- Redis ----------
# Redis 访问口令（必填，启动时启用 protected-mode + requirepass）
REDIS_PASSWORD=change_me_redis_password
# 宿主机映射端口（仅绑回环 127.0.0.1，调试用）
REDIS_PORT=6379

# ---------- RabbitMQ ----------
# AMQP 业务账号（同时作为管理控制台登录账号）
RABBITMQ_USERNAME=seckill
# AMQP 业务账号口令
RABBITMQ_PASSWORD=change_me_rabbitmq_password
# AMQP 协议端口（仅绑回环 127.0.0.1，调试用）
RABBITMQ_PORT=5672
# RabbitMQ 管理控制台端口（仅绑回环 127.0.0.1，调试用）
RABBITMQ_MGMT_PORT=15672

# ---------- 应用 (seckill-mall 后端) ----------
# 秒杀签名密钥（服务端防重放 token 用，长度 >= 32 字节）
SECKILL_SIGN_SECRET=change_me_sign_secret_at_least_32_chars_long
# CORS 允许的来源（生产环境填实际域名，逗号分隔）
# 例：https://seckillmall.com,https://www.seckillmall.com
CORS_ALLOWED_ORIGINS=http://localhost
# 可信代理 IP 白名单（逗号分隔，可选）
# 前端经 Nginx 反向代理访问后端时，需配置 Nginx 容器 IP 或网段
# 留空则不信任任何代理，X-Forwarded-* 头将被忽略
TRUSTED_PROXY_IPS=
# JWT RSA 密钥目录（挂载到容器 /app/keys:ro）
# 该目录需包含 private.pem 和 public.pem 两个文件
JWT_KEYS_DIR=./keys

# ---------- 前端 (Nginx + Vue SPA) ----------
# 浏览器访问端口（默认 80，生产建议改为 80 或经反向代理/CDN 接管）
FRONTEND_PORT=80