target/
*.iml
.idea/
*.log
application-local.yml

# 文档内容
.docs/
.trae/
# docs/ 目录：内部技术文档（含 PII / 设计方案 / 流程图），不对外公开，禁止入库
docs/

# Tool metadata
.arts/
*.merkle-snapshot.json

# Frontend
node_modules/
frontend/dist/
frontend/.vite/
*.local

# Environment files with secrets
# B2/M-K1 修复: 旧规则 *.env 匹配不到 .env.development / .env.production,
# 改为 .env / .env.* 覆盖所有 .env 变体, 保留 .env.example 与 *.example 模板.
.env
.env.*
*.env
!.env.example
!.env.*.example

# ============================================================
# B1 修复: RSA 私钥/公钥禁止入库，必须由部署环境挂载（K8s Secret / Vault）
# ============================================================
**/resources/keys/*.pem
*.pem

# ============================================================
# B5 修复: 含 PII 的数据库转储/迁移脚本禁止入库
# ============================================================
*_dump.sql
*_dump*.sql
seckill_mall.sql
**/seckill_mall.sql

# 日志/堆栈转储
*.dump
*.hprof

# ============================================================
# 商品图片资源：seckill-mall/images/ 含 116+ 商品图片子目录（products/、product-detail/、review/），
# 体积大且可由初始化数据脚本或对象存储重建，禁止入库
# 注意：仅忽略 images/ 目录，不影响 seckill-mall/ 下其他目录
# ============================================================
seckill-mall/images/

# ============================================================
# 备份/日志/旧版本文件禁止入库
# - *.zip: 项目压缩包备份（体积大且易过时）
# - error.md: 运行时错误日志/堆栈转储
# - *.pdf: PDF 文档（大文件，README 以 md 为准）
# ============================================================
*.zip
error.md
*.pdf
