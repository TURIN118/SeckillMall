/* components/captcha-image/captcha-image.wxss — 图形验证码组件样式 */

.captcha-image {
  position: relative;
  width: 200rpx;
  height: 80rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background-color: #f7f8fa;
  border: 1rpx solid #dcdee0;
}

.captcha-image__img {
  width: 100%;
  height: 100%;
  display: block;
}

.captcha-image__placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #969799;
  text-align: center;
  line-height: 1.4;
}