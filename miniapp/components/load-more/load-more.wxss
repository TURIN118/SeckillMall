/* components/load-more/load-more.wxss */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  width: 100%;
  box-sizing: border-box;
}

.load-more__inner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.load-more__inner--tap {
  padding: 16rpx 24rpx;
}

.load-more__text {
  font-size: 24rpx;
  color: #969799;
  margin-left: 12rpx;
}

.load-more__text--muted {
  color: #C8C9CC;
}

.load-more__text--error {
  color: #FF4444;
}