/* components/product-card/product-card.wxss */
.product-card {
  display: flex;
  flex-direction: column;
  background: #ffffff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.product-card--hover {
  opacity: 0.85;
}

.product-card__image-wrap {
  width: 100%;
  height: 340rpx;
  background: #f7f8fa;
}

.product-card__image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #c8c9cc;
}

.product-card__placeholder-text {
  font-size: 24rpx;
  color: #c8c9cc;
}

.product-card__body {
  padding: 16rpx 20rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 商品名：2 行省略 */
.product-card__name {
  font-size: 28rpx;
  color: #323233;
  line-height: 1.4;
  /* 2 行省略 */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-all;
  min-height: 78rpx;
}

.product-card__bottom {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 8rpx;
}

.product-card__sales {
  font-size: 22rpx;
  color: #969799;
  flex-shrink: 0;
}