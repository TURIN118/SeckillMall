<!-- pages/cart/cart.wxml -->
<view class="cart">

  <!-- 加载中 -->
  <view class="cart__loading" wx:if="{{loading && items.length === 0}}">
    <van-loading size="24px">加载中...</van-loading>
  </view>

  <!-- 空状态 -->
  <view class="cart__empty" wx:if="{{!loading && isEmpty}}">
    <van-empty description="购物车空空如也" />
    <van-button type="danger" round custom-class="cart__empty-btn" bind:click="onGoShopping">
      去逛逛
    </van-button>
  </view>

  <!-- 列表 -->
  <view class="cart__list" wx:if="{{!loading && items.length > 0}}">
    <van-swipe-cell
      wx:for="{{items}}"
      wx:key="id"
      wx:for-item="item"
      wx:for-index="index"
      right-width="{{ 65 }}"
      custom-class="cart__swipe-cell"
    >
      <view class="cart__item">
        <!-- 选中框 -->
        <view class="cart__item-check">
          <van-checkbox
            value="{{item.selected}}"
            data-index="{{index}}"
            bind:change="onItemSelect"
          />
        </view>
        <!-- 商品图 + 信息（点击跳详情） -->
        <view class="cart__item-product" bindtap="onTapProduct" data-product-id="{{item.productId}}">
          <!-- 商品图 -->
          <view class="cart__item-image">
            <van-image
              width="160rpx"
              height="160rpx"
              src="{{item._image}}"
              fit="cover"
              lazy-load
            />
          </view>
          <!-- 商品信息 -->
          <view class="cart__item-info">
            <view class="cart__item-name">{{item.productName}}</view>
            <view class="cart__item-sku" wx:if="{{item.skuName}}">{{item.skuName}}</view>
            <view class="cart__item-bottom">
              <view class="cart__item-price">
                <text class="cart__item-price-symbol">¥</text>
                <text class="cart__item-price-value">{{item.originalPrice}}</text>
              </view>
              <van-stepper
                value="{{item.quantity}}"
                min="1"
                integer
                data-index="{{index}}"
                catch:change="onStepperChange"
              />
            </view>
          </view>
        </view>
      </view>
      <!-- 右滑删除 -->
      <view slot="right" class="cart__item-delete" data-index="{{index}}" bindtap="onRemoveItem">
        删除
      </view>
    </van-swipe-cell>
  </view>

  <!-- 底部结算栏 -->
  <view class="cart__submit-bar" wx:if="{{items.length > 0}}">
    <view class="cart__submit-bar-check">
      <van-checkbox
        value="{{allSelected}}"
        bind:change="onToggleAll"
      >全选</van-checkbox>
    </view>
    <view class="cart__submit-bar-total">
      <text class="cart__submit-bar-total-label">合计：</text>
      <text class="cart__submit-bar-total-symbol">¥</text>
      <text class="cart__submit-bar-total-value">{{formattedTotal}}</text>
    </view>
    <view class="cart__submit-bar-btn {{selectedCount === 0 ? 'is-disabled' : ''}}" bindtap="onCheckout">
      结算({{selectedCount}})
    </view>
  </view>

</view>