/* pages/cart/cart.wxss */
.cart {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

/* 加载 */
.cart__loading {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

/* 空状态 */
.cart__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  gap: 32rpx;
}

.cart__empty-btn {
  width: 240rpx !important;
}

/* 列表 */
.cart__list {
  padding: 20rpx;
}

/* van-swipe-cell 间距（通过 custom-class 注入） */
.cart__swipe-cell {
  margin-bottom: 16rpx;
}

/* 单项 */
.cart__item {
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 24rpx;
  border-radius: 12rpx;
  gap: 16rpx;
}

.cart__item-check {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
}

.cart__item-product {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.cart__item-image {
  flex-shrink: 0;
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #f7f8fa;
}

.cart__item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
  /* 固定高度区，使各项对齐：图片 160rpx，信息区与图片等高 */
  height: 160rpx;
}

.cart__item-name {
  font-size: 28rpx;
  color: #323233;
  line-height: 1.4;
  /* 2 行省略 */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
}

.cart__item-sku {
  font-size: 24rpx;
  color: #969799;
  background: #f2f3f5;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  align-self: flex-start;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cart__item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  /* 固定在信息区底部 */
  margin-top: auto;
}

.cart__item-price {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.cart__item-price-symbol {
  font-size: 24rpx;
  color: #FF4444;
}

.cart__item-price-value {
  font-size: 32rpx;
  color: #FF4444;
  font-weight: 600;
}

/* 删除按钮 */
.cart__item-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 130rpx;
  height: 100%;
  background: #FF4444;
  color: #ffffff;
  font-size: 28rpx;
}

/* 底部结算栏（自定义固定） */
.cart__submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.cart__submit-bar-check {
  display: flex;
  align-items: center;
  padding-left: 24rpx;
  flex-shrink: 0;
}

.cart__submit-bar-total {
  flex: 1;
  display: flex;
  align-items: baseline;
  padding-left: 24rpx;
}

.cart__submit-bar-total-label {
  font-size: 28rpx;
  color: #323233;
}

.cart__submit-bar-total-symbol {
  font-size: 24rpx;
  color: #FF4444;
  font-weight: 600;
}

.cart__submit-bar-total-value {
  font-size: 36rpx;
  color: #FF4444;
  font-weight: 600;
}

.cart__submit-bar-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 220rpx;
  height: 100%;
  background: linear-gradient(135deg, #ff4444, #ee0a24);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
}

.cart__submit-bar-btn.is-disabled {
  opacity: 0.5;
}
