/* pages/favorites/favorites.wxss */
.favorites {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 20rpx;
}

/* 加载 */
.favorites__loading {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

/* 空状态 */
.favorites__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  gap: 32rpx;
}

.favorites__empty-btn {
  width: 240rpx !important;
}

/* 2 列网格 */
.favorites__grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.favorites__grid-item {
  width: calc((100% - 20rpx) / 2);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 取消收藏按钮 */
.favorites__remove {
  align-self: center;
  font-size: 24rpx;
  color: #969799;
  padding: 8rpx 24rpx;
  border: 1rpx solid #dcdee0;
  border-radius: 24rpx;
  background: #ffffff;
}

.favorites__remove:active {
  color: #FF4444;
  border-color: #FF4444;
}