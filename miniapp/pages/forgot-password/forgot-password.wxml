<!-- pages/forgot-password/forgot-password.wxml — 找回密码页 -->
<!-- 对齐 spec 5.3：验证方式选择 + 账号 + 验证码 + 新密码 -->
<view class="forgot-page">
  <view class="forgot-page__header">
    <text class="forgot-page__title">找回密码</text>
    <text class="forgot-page__subtitle">通过手机号或邮箱重置密码</text>
  </view>

  <van-form bind:submit="handleReset">
    <van-cell-group inset>
      <!-- 验证方式选择 -->
      <van-field label="验证方式">
        <van-radio-group
          slot="input"
          value="{{ type }}"
          direction="horizontal"
          bind:change="onTypeChange"
        >
          <van-radio name="PHONE">手机号</van-radio>
          <van-radio name="EMAIL">邮箱</van-radio>
        </van-radio-group>
      </van-field>

      <!-- 账号 -->
      <van-field
        value="{{ account }}"
        label="账号"
        placeholder="{{ type === 'PHONE' ? '请输入手机号' : '请输入邮箱' }}"
        required
        clearable
        bind:input="onAccountInput"
      ></van-field>

      <!-- 验证码 + 发送按钮 -->
      <van-field
        value="{{ code }}"
        label="验证码"
        placeholder="请输入验证码"
        required
        clearable
        bind:input="onCodeInput"
      >
        <view slot="right-icon" class="forgot-page__send">
          <van-button
            type="primary"
            size="small"
            plain
            disabled="{{ countdown > 0 || sending }}"
            loading="{{ sending }}"
            bind:click="handleSendCode"
          >
            <text wx:if="{{ countdown > 0 }}">{{ countdown }}s</text>
            <text wx:else>发送验证码</text>
          </van-button>
        </view>
      </van-field>

      <!-- 新密码 -->
      <van-field
        value="{{ newPassword }}"
        label="新密码"
        placeholder="6-20 个字符"
        password
        required
        clearable
        bind:input="onNewPasswordInput"
      ></van-field>
    </van-cell-group>

    <view class="forgot-page__submit">
      <van-button type="primary" block round form-type="submit" loading="{{ submitting }}">
        重置密码
      </van-button>
    </view>
  </van-form>

  <view class="forgot-page__footer">
    <navigator url="/pages/login/login" hover-class="none" class="forgot-page__link">
      返回登录
    </navigator>
  </view>
</view>