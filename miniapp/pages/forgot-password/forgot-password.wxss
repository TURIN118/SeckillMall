/* pages/forgot-password/forgot-password.wxss — 找回密码页样式 */

.forgot-page {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding: 0 0 60rpx;
  box-sizing: border-box;
}

.forgot-page__header {
  padding: 80rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.forgot-page__title {
  font-size: 48rpx;
  font-weight: 600;
  color: #323233;
  line-height: 1.4;
}

.forgot-page__subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #969799;
}

.forgot-page__send {
  display: flex;
  align-items: center;
}

.forgot-page__submit {
  padding: 40rpx 32rpx 0;
}

.forgot-page__footer {
  display: flex;
  justify-content: center;
  padding: 40rpx 48rpx 0;
}

.forgot-page__link {
  font-size: 28rpx;
  color: #1989fa;
}

.forgot-page__link:active {
  opacity: 0.7;
}