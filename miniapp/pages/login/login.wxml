<!-- pages/login/login.wxml — 登录页 -->
<!-- 对齐 spec 5.1：用户名/密码登录，失败≥3 次显示图形验证码 -->
<view class="login-page">
  <view class="login-page__header">
    <text class="login-page__title">欢迎登录</text>
    <text class="login-page__subtitle">秒杀商城小程序</text>
  </view>

  <view>
    <van-cell-group inset>
      <van-field
        value="{{ username }}"
        label="用户名"
        placeholder="请输入用户名"
        required
        clearable
        bind:input="onUsernameInput"
      ></van-field>
      <van-field
        value="{{ password }}"
        label="密码"
        placeholder="请输入密码"
        password
        required
        clearable
        bind:input="onPasswordInput"
      ></van-field>

      <!-- 验证码区域：失败≥3 次显示 -->
      <van-field
        wx:if="{{ showCaptcha }}"
        value="{{ captchaCode }}"
        label="验证码"
        placeholder="请输入图形验证码"
        required
        clearable
        bind:input="onCaptchaCodeInput"
      >
        <view slot="right-icon" class="login-page__captcha">
          <captcha-image
            image="{{ captchaImage }}"
            captcha-key="{{ captchaKey }}"
            bind:update="onCaptchaUpdate"
          ></captcha-image>
        </view>
      </van-field>
    </van-cell-group>

    <view class="login-page__submit">
      <van-button type="primary" block round bind:click="handleLogin" loading="{{ submitting }}">
        登录
      </van-button>
    </view>
  </view>

  <view class="login-page__footer">
    <navigator url="/pages/register/register" hover-class="none" class="login-page__link">
      去注册
    </navigator>
    <navigator
      url="/pages/forgot-password/forgot-password"
      hover-class="none"
      class="login-page__link"
    >
      忘记密码
    </navigator>
  </view>
</view>