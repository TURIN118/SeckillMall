/* pages/login/login.wxss — 登录页样式 */

.login-page {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding: 0 0 60rpx;
  box-sizing: border-box;
}

.login-page__header {
  padding: 80rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.login-page__title {
  font-size: 48rpx;
  font-weight: 600;
  color: #323233;
  line-height: 1.4;
}

.login-page__subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #969799;
}

.login-page__submit {
  padding: 40rpx 32rpx 0;
}

.login-page__captcha {
  display: flex;
  align-items: center;
}

.login-page__footer {
  display: flex;
  justify-content: space-between;
  padding: 40rpx 48rpx 0;
}

.login-page__link {
  font-size: 28rpx;
  color: #1989fa;
}

.login-page__link:active {
  opacity: 0.7;
}