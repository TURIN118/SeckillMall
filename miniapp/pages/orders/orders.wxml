<!-- pages/orders/orders.wxml -->
<view class="orders">

  <!-- 顶部状态筛选 -->
  <van-tabs
    active="{{activeTab}}"
    color="#FF4444"
    title-active-color="#FF4444"
    bind:change="onTabChange"
    sticky
  >
    <van-tab wx:for="{{tabs}}" wx:key="value" wx:for-item="tab" title="{{tab.name}}"></van-tab>
  </van-tabs>

  <!-- 列表 -->
  <view class="orders__list" wx:if="{{orders.length > 0}}">
    <van-swipe-cell
      wx:for="{{orders}}"
      wx:key="orderId"
      wx:for-item="order"
      wx:for-index="index"
      right-width="{{ 65 }}"
      disabled="{{order.status !== 'COMPLETED' && order.status !== 'CANCELLED'}}"
    >
      <order-card
        order="{{order}}"
        bind:tap="onTapOrder"
      />
      <view slot="right" class="orders__delete" data-index="{{index}}" bindtap="onDeleteOrder">
        删除
      </view>
    </van-swipe-cell>
  </view>

  <!-- 空状态 -->
  <van-empty wx:if="{{!loading && isEmpty}}" description="暂无订单" />

  <!-- 加载更多 -->
  <load-more
    wx:if="{{orders.length > 0}}"
    status="{{loadMoreStatus}}"
    bind:retry="onTapRetry"
  />

  <!-- 顶部首次加载 -->
  <view wx:if="{{loading && orders.length === 0}}" class="orders__loading">
    <van-loading size="24px">加载中...</van-loading>
  </view>

</view>