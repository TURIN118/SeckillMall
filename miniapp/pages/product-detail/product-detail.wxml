<!-- pages/product-detail/product-detail.wxml -->
<view class="product-detail" wx:if="{{!loading && !loadError && product}}">

  <!-- 顶部图片轮播 -->
  <swiper
    wx:if="{{product.images.length > 0}}"
    class="product-detail__swiper"
    autoplay
    circular
    indicator-dots
    indicator-color="rgba(255,255,255,0.6)"
    indicator-active-color="#ffffff"
  >
    <swiper-item wx:for="{{product.images}}" wx:key="*this" wx:for-item="img">
      <van-image width="100%" height="750rpx" src="{{img}}" fit="cover" lazy-load />
    </swiper-item>
  </swiper>

  <!-- 商品信息区 -->
  <view class="product-detail__info">
    <view class="product-detail__name">{{product.productName}}</view>
    <view class="product-detail__price-row">
      <price-tag price="{{displayPrice}}" size="lg" highlight="{{true}}"></price-tag>
      <view class="product-detail__sales-stock">
        <text class="product-detail__sales" wx:if="{{product.salesCount}}">已售{{product.salesCount}}</text>
        <text class="product-detail__stock">库存{{displayStock}}</text>
      </view>
    </view>
  </view>

  <!-- SKU 入口 -->
  <van-cell
    wx:if="{{hasSku}}"
    title="选择规格"
    is-link
    value="{{currentSku ? '已选' : '请选择'}}"
    bindtap="onOpenSkuPanel"
  />

  <!-- 参数列表 -->
  <view class="product-detail__attrs" wx:if="{{product.attributes && product.attributes.length > 0}}">
    <view class="product-detail__section-title">商品参数</view>
    <van-cell-group>
      <van-cell
        wx:for="{{product.attributes}}"
        wx:key="name"
        title="{{item.name || item.attributeName}}"
        value="{{item.value || item.attributeValue}}"
      />
    </van-cell-group>
  </view>

  <!-- 富文本详情 -->
  <view class="product-detail__rich">
    <view class="product-detail__section-title">商品详情</view>
    <rich-text-viewer html="{{product.detailHtml}}"></rich-text-viewer>
  </view>

  <!-- 占位：避免被底部操作栏遮挡 -->
  <view class="product-detail__bottom-placeholder"></view>

  <!-- 底部操作栏 -->
  <van-goods-action>
    <van-goods-action-icon
      icon="star-o"
      text="收藏"
      bind:click="onToggleFavorite"
    />
    <van-goods-action-button
      type="warning"
      text="加入购物车"
      disabled="{{!canBuy || submitting}}"
      bind:click="onAddCart"
    />
    <van-goods-action-button
      type="danger"
      text="立即购买"
      disabled="{{!canBuy || submitting}}"
      bind:click="onBuyNow"
    />
  </van-goods-action>

  <!-- SKU 选择面板 -->
  <sku-selector
    show="{{showSkuPanel}}"
    skus="{{product.skus}}"
    attributes="{{product.attributes}}"
    bind:confirm="onSkuConfirm"
    bind:close="onCloseSkuPanel"
  ></sku-selector>

</view>

<!-- 加载中 -->
<view class="product-detail__loading" wx:if="{{loading}}">
  <van-loading size="32px">加载中...</van-loading>
</view>

<!-- 错误态 -->
<view class="product-detail__error" wx:if="{{!loading && loadError}}">
  <van-empty description="商品不存在或加载失败" />
  <van-button type="danger" bind:click="onTapRetry">重新加载</van-button>
  <van-button plain bind:click="onGoBack" custom-style="margin-top: 16rpx;">返回上一页</van-button>
</view>