/* pages/profile/profile.wxss */

.profile {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding-bottom: 40rpx;
}

/* 用户卡 */
.profile__user-card {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, #FF4444 0%, #FF6B6B 100%);
  color: #fff;
}

.profile__user-card--hover {
  opacity: 0.92;
}

.profile__avatar {
  flex-shrink: 0;
}

.profile__avatar-fallback {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #f7f8fa;
  color: #ccc;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile__user-info {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
}

.profile__nickname {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile__phone {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.profile__phone--muted {
  color: rgba(255, 255, 255, 0.75);
}

.profile__arrow {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-left: 12rpx;
}

/* section 通用 */
.profile__section {
  margin-top: 20rpx;
  background-color: #fff;
}

.profile__section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 12rpx;
}

.profile__section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
}

.profile__section-more {
  font-size: 26rpx;
  color: #969799;
}

/* 订单状态宫格 */
.profile__order-status {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
}

.profile__order-icon {
  font-size: 48rpx;
  line-height: 1;
}

.profile__order-name {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #646566;
}

/* 退出登录 */
.profile__logout {
  margin: 40rpx 32rpx 0;
}