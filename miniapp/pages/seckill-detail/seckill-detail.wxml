<!-- pages/seckill-detail/seckill-detail.wxml -->
<view class="seckill-detail" wx:if="{{!loading && !loadError && detail}}">

  <!-- 顶部图片轮播 -->
  <swiper
    wx:if="{{images.length > 0}}"
    class="seckill-detail__swiper"
    autoplay
    circular
    indicator-dots
    indicator-color="rgba(255,255,255,0.6)"
    indicator-active-color="#ffffff"
  >
    <swiper-item wx:for="{{images}}" wx:key="*this" wx:for-item="img">
      <van-image width="100%" height="750rpx" src="{{img}}" fit="cover" lazy-load />
    </swiper-item>
  </swiper>
  <view wx:else class="seckill-detail__swiper-placeholder">
    <van-image width="100%" height="750rpx" fit="cover" />
  </view>

  <!-- 商品信息区 -->
  <view class="seckill-detail__info">
    <view class="seckill-detail__price-row">
      <view class="seckill-detail__seckill-price">
        <text class="seckill-detail__symbol">¥</text>
        <text class="seckill-detail__amount">{{seckillPrice}}</text>
      </view>
      <view class="seckill-detail__original-price" wx:if="{{originalPrice > seckillPrice}}">
        <text>¥{{originalPrice}}</text>
      </view>
      <view class="seckill-detail__seckill-tag">
        <text>秒杀</text>
      </view>
    </view>
    <view class="seckill-detail__name">{{productName}}</view>
    <view class="seckill-detail__meta">
      <text class="seckill-detail__stock">库存 {{stock}}</text>
    </view>
  </view>

  <!-- 倒计时区 -->
  <view class="seckill-detail__countdown-bar">
    <text class="seckill-detail__countdown-label">秒杀倒计时</text>
    <seckill-countdown
      class="seckill-detail__countdown"
      start-time="{{startTime}}"
      end-time="{{endTime}}"
      bind:statuschange="onCountdownStatusChange"
    />
  </view>

  <!-- 占位：避免被底部操作栏遮挡 -->
  <view class="seckill-detail__bottom-placeholder"></view>

  <!-- 底部操作栏 -->
  <van-goods-action>
    <van-goods-action-icon
      icon="shop-o"
      text="首页"
      bind:click="onGoBack"
    />
    <van-goods-action-button
      type="danger"
      text="{{submitting ? '抢购中...' : btnText}}"
      disabled="{{btnDisabled || submitting}}"
      loading="{{submitting}}"
      bind:click="onSeckillTap"
    />
  </van-goods-action>

</view>

<!-- 加载中 -->
<view class="seckill-detail__loading" wx:if="{{loading}}">
  <van-loading size="32px">加载中...</van-loading>
</view>

<!-- 错误态 -->
<view class="seckill-detail__error" wx:if="{{!loading && loadError}}">
  <van-empty description="秒杀商品不存在或加载失败" />
  <van-button type="danger" bind:click="onTapRetry">重新加载</van-button>
  <van-button plain bind:click="onGoBack" custom-style="margin-top: 16rpx;">返回上一页</van-button>
</view>