/* pages/seckill-detail/seckill-detail.wxss */
.seckill-detail {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: 120rpx;
}

/* 图片轮播 */
.seckill-detail__swiper {
  width: 100%;
  height: 750rpx;
}

.seckill-detail__swiper-placeholder {
  width: 100%;
  height: 750rpx;
  background: #f2f3f5;
}

/* 商品信息区 */
.seckill-detail__info {
  background: #ffffff;
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.seckill-detail__price-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.seckill-detail__seckill-price {
  display: inline-flex;
  align-items: baseline;
  color: #FF4444;
}

.seckill-detail__symbol {
  font-size: 28rpx;
  color: #FF4444;
}

.seckill-detail__amount {
  font-size: 56rpx;
  color: #FF4444;
  font-weight: 700;
  line-height: 1;
}

.seckill-detail__original-price {
  font-size: 28rpx;
  color: #969799;
  text-decoration: line-through;
}

.seckill-detail__seckill-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 16rpx;
  background: #FF4444;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 600;
}

.seckill-detail__name {
  font-size: 32rpx;
  color: #323233;
  line-height: 1.5;
  font-weight: 500;
}

.seckill-detail__meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.seckill-detail__stock {
  font-size: 26rpx;
  color: #969799;
}

/* 倒计时区 */
.seckill-detail__countdown-bar {
  margin-top: 16rpx;
  background: linear-gradient(135deg, #FF4444 0%, #FF6B6B 100%);
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.seckill-detail__countdown-label {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 600;
}

.seckill-detail__countdown {
  flex: 1;
  display: flex;
  justify-content: flex-end;
}

/* 底部占位 */
.seckill-detail__bottom-placeholder {
  height: 120rpx;
}

/* 加载/错误态 */
.seckill-detail__loading,
.seckill-detail__error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
  gap: 24rpx;
  min-height: 100vh;
}