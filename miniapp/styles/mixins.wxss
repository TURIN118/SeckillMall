/* styles/mixins.wxss — 公共样式片段
 *
 * 微信小程序 WXSS 不支持 mixin 语法，本文件以"公共类"形式提供可复用样式片段，
 * 业务页面通过 @import 或在 wxml 中直接使用类名复用。
 * 当前 infra 阶段放置最小占位，后续按需扩展。
 */

/* 卡片基础样式 */
.mixin-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* 单行省略 */
.mixin-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 多行省略（2 行） */
.mixin-ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 安全区域底部留白 */
.mixin-safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}