<!-- subpackages/user-center/address-list/address-list.wxml -->
<view class="address-list">

  <!-- 加载中 -->
  <view class="address-list__loading" wx:if="{{loading && addresses.length === 0}}">
    <van-loading size="24px">加载中...</van-loading>
  </view>

  <!-- 空状态 -->
  <view class="address-list__empty" wx:if="{{!loading && isEmpty}}">
    <van-empty description="暂无收货地址" />
    <van-button type="danger" round custom-class="address-list__empty-btn" bind:click="onAddNew">
      新增地址
    </van-button>
  </view>

  <!-- 列表 -->
  <view class="address-list__list" wx:if="{{addresses.length > 0}}">
    <van-swipe-cell
      wx:for="{{addresses}}"
      wx:key="id"
      wx:for-item="address"
      wx:for-index="index"
      right-width="{{ 65 }}"
    >
      <address-card
        address="{{address}}"
        selectable="{{selectMode}}"
        selected="{{selectMode && selectedId === address.id}}"
        show-set-default="{{!selectMode}}"
        bind:tap="onTapAddress"
        bind:select="onTapAddress"
        bind:setdefault="onSetDefault"
        bind:edit="onEditAddress"
      />
      <view slot="right" class="address-list__delete" data-index="{{index}}" bindtap="onDeleteAddress">
        删除
      </view>
    </van-swipe-cell>
  </view>

  <!-- 底部新增按钮 -->
  <view class="address-list__footer" wx:if="{{addresses.length > 0}}">
    <van-button type="danger" round block bind:click="onAddNew">新增地址</van-button>
  </view>

</view>