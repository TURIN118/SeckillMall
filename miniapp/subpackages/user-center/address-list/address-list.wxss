/* subpackages/user-center/address-list/address-list.wxss */
.address-list {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 20rpx;
  padding-bottom: 140rpx;
}

/* 加载 */
.address-list__loading {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

/* 空状态 */
.address-list__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  gap: 32rpx;
}

.address-list__empty-btn {
  width: 240rpx !important;
}

/* 列表 */
.address-list__list {
  /* address-card 自带 margin-bottom */
}

/* 删除按钮 */
.address-list__delete {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 130rpx;
  height: 100%;
  background: #FF4444;
  color: #ffffff;
  font-size: 28rpx;
}

/* 底部新增按钮 */
.address-list__footer {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  padding: 0 20rpx;
}