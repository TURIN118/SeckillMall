<!-- subpackages/user-center/change-password/change-password.wxml -->
<view class="change-pwd">

  <van-cell-group inset>
    <van-field
      value="{{oldPassword}}"
      type="password"
      label="原密码"
      placeholder="请输入原密码"
      maxlength="64"
      bind:change="onOldPasswordInput"
    />
    <van-field
      value="{{newPassword}}"
      type="password"
      label="新密码"
      placeholder="至少 8 位，含字母和数字"
      maxlength="64"
      bind:change="onNewPasswordInput"
    />
    <van-field
      value="{{confirmPassword}}"
      type="password"
      label="确认密码"
      placeholder="请再次输入新密码"
      maxlength="64"
      bind:change="onConfirmPasswordInput"
    />
  </van-cell-group>

  <view class="change-pwd__tips">
    <text>· 新密码至少 8 位，需同时包含字母和数字</text>
    <text>· 修改成功后建议重新登录</text>
  </view>

  <view class="change-pwd__submit">
    <van-button
      block
      type="danger"
      loading="{{submitting}}"
      bind:tap="onSubmit"
    >确认修改</van-button>
  </view>

</view>