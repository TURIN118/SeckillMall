<!-- subpackages/user-center/profile-edit/profile-edit.wxml -->
<view class="profile-edit">

  <!-- 区段标题：基本信息 -->
  <view class="profile-edit__section-title">基本信息</view>

  <!-- 头像 -->
  <view class="profile-edit__avatar-row" bindtap="onChooseAvatar" hover-class="profile-edit__row--hover" hover-stay-time="100">
    <text class="profile-edit__row-label">头像</text>
    <view class="profile-edit__avatar-wrap">
      <van-image
        width="100rpx"
        height="100rpx"
        round
        src="{{avatarUrl}}"
        fit="cover"
      >
        <view slot="error" class="profile-edit__avatar-fallback">👤</view>
        <view slot="loading" class="profile-edit__avatar-fallback">👤</view>
      </van-image>
      <text class="profile-edit__arrow">›</text>
    </view>
  </view>

  <!-- 昵称 -->
  <view class="profile-edit__nickname-row">
    <text class="profile-edit__row-label">昵称</text>
    <van-field
      value="{{nickname}}"
      placeholder="请输入昵称"
      maxlength="32"
      border="{{false}}"
      bind:change="onNicknameInput"
    />
  </view>

  <!-- 保存按钮（基本信息区） -->
  <view class="profile-edit__save">
    <van-button
      block
      type="danger"
      loading="{{saving}}"
      bind:tap="onSave"
    >保存基本信息</van-button>
  </view>

  <!-- 区段标题：账号安全 -->
  <view class="profile-edit__section-title">账号安全</view>

  <!-- 账号安全入口列表 -->
  <van-cell-group inset>
    <van-cell
      title="修改密码"
      is-link
      bind:tap="onTapChangePassword"
    />
    <van-cell
      title="修改手机号"
      value="{{phoneMasked || '未绑定'}}"
      is-link
      bind:tap="onTapPhone"
    />
    <van-cell
      title="修改邮箱"
      value="{{email || '未绑定'}}"
      is-link
      bind:tap="onTapEmail"
    />
  </van-cell-group>

</view>
