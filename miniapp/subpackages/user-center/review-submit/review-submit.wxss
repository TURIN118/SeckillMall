/* subpackages/user-center/review-submit/review-submit.wxss */

.review-submit {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding-bottom: 40rpx;
}

/* 商品信息 */
.review-submit__product {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background-color: #fff;
}

.review-submit__product-info {
  margin-left: 24rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.review-submit__product-name {
  font-size: 28rpx;
  color: #323233;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.review-submit__product-price {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #FF4444;
}

.review-submit__product-loading {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
  background-color: #fff;
}

/* section */
.review-submit__section {
  margin-top: 20rpx;
  background-color: #fff;
  padding: 24rpx 32rpx;
}

.review-submit__section-label {
  font-size: 28rpx;
  color: #646566;
  margin-bottom: 16rpx;
}

/* 图片选择 */
.review-submit__images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.review-submit__image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.review-submit__image-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.review-submit__image-add {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #dcdee0;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  color: #dcdee0;
}

/* 提交 */
.review-submit__submit {
  margin: 60rpx 32rpx 0;
}