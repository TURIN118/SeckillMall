/* subpackages/user-center/wallet-detail/wallet-detail.wxss */

.wallet {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding-bottom: 40rpx;
}

/* 余额卡片 */
.wallet__balance-card {
  background: linear-gradient(135deg, #FF4444 0%, #FF8E53 100%);
  padding: 48rpx 32rpx;
  color: #fff;
  position: relative;
}

.wallet__balance-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.wallet__balance-value {
  margin-top: 16rpx;
  font-size: 64rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1.2;
}

.wallet__recharge-btn {
  position: absolute;
  right: 32rpx;
  bottom: 48rpx;
}

/* section */
.wallet__section {
  margin-top: 20rpx;
  background-color: #fff;
}

.wallet__section-header {
  padding: 24rpx 32rpx 12rpx;
}

.wallet__section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
}

.wallet__loading {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
}

/* 交易记录 */
.wallet__records {
  /* 列表容器 */
}

.wallet__record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #ebedf0;
}

.wallet__record-left {
  display: flex;
  flex-direction: column;
}

.wallet__record-type {
  font-size: 28rpx;
  color: #323233;
  font-weight: 500;
}

.wallet__record-time {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #969799;
}

.wallet__record-amount {
  font-size: 30rpx;
  font-weight: 600;
}

.wallet__record-amount--RECHARGE,
.wallet__record-amount--REFUND {
  color: #FF4444;
}

.wallet__record-amount--CONSUME,
.wallet__record-amount--WITHDRAW {
  color: #323233;
}

/* 充值弹窗 */
.recharge-popup {
  padding: 32rpx 0 60rpx;
}

.recharge-popup__title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
  padding: 8rpx 0 24rpx;
}

.recharge-popup__actions {
  display: flex;
  gap: 24rpx;
  padding: 40rpx 32rpx 0;
}

.recharge-popup__actions > van-button {
  flex: 1;
}