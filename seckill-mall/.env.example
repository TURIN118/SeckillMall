# 复制此文件为 .env 并填入真实值
# cp .env.example .env

# ===== 数据库 =====
DB_USERNAME=root
DB_PASSWORD=your-db-password-here

# ===== RabbitMQ =====
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=your-rabbitmq-password-here

# ===== 邮件服务 =====
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-auth-code-here

# ===== JWT RSA 密钥路径 =====
JWT_RSA_PRIVATE_KEY_PATH=classpath:keys/private.pem
JWT_RSA_PUBLIC_KEY_PATH=classpath:keys/public.pem

# ===== 秒杀 HMAC 签名密钥 =====
SECKILL_SIGN_SECRET=your-hmac-sign-secret-here
