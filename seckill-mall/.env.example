# 复制此文件为 .env 并填入真实值
# cp .env.example .env

# ===== 数据库（H-K3：生产必填，无默认值）=====
DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=seckill_app
DB_PASSWORD=your-db-password-here
MYSQL_DATABASE=seckill_mall
MYSQL_ROOT_PASSWORD=your-root-password-here

# ===== Redis（H-K2：生产必填）=====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password-here

# ===== RabbitMQ（H-K4：生产必填）=====
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=seckill_app
RABBITMQ_PASSWORD=your-rabbitmq-password-here
RABBITMQ_MGMT_PORT=15672

# ===== 邮件服务 =====
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-auth-code-here

# ===== JWT RSA 密钥路径（B1 修复：运行时挂载，不进 classpath/仓库）=====
# 开发环境可用 classpath 路径；生产环境挂载到 /app/keys/
JWT_RSA_PRIVATE_KEY_PATH=classpath:keys/private.pem
JWT_RSA_PUBLIC_KEY_PATH=classpath:keys/public.pem
# Docker 部署时私钥挂载目录
JWT_KEYS_DIR=./keys

# ===== 秒杀安全（B2 修复：服务端 token 签发密钥，>= 32 字符）=====
SECKILL_SIGN_SECRET=your-server-side-sign-secret-at-least-32-chars-long

# ===== CORS（M-K2 修复：生产显式注入，不允许通配 *）=====
CORS_ALLOWED_ORIGINS=https://your-production-domain.com

# ===== 可信反向代理 IP 白名单（C2 修复：逗号分隔）=====
TRUSTED_PROXY_IPS=127.0.0.1,::1

# ===== 验证码每日上限（C2 修复）=====
VERIFY_DAILY_LIMIT_PER_TARGET=10

# ===== Spring Profile =====
SPRING_PROFILES_ACTIVE=dev
